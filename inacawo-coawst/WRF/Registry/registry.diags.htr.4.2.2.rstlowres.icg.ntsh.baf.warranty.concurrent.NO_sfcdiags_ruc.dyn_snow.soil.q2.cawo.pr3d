#	Registry file specifically for some additional diagnostic output from WRF.  

#	PRESSURE  

#  The new dimspec.  We need to have the number of pressure levels to interpolate to.

dimspec    np      2     namelist=num_press_levels         z     num_press_levels

#  Namelist parameters

rconfig   integer     p_lev_diags         namelist,diags   1              0   -    "flag to process vertical interp diagnostics: 0=nope, 1=yep"             "flag"
rconfig   integer     p_lev_diags_dfi     namelist,diags   1              0   -    "when doing p_level diags and dfi, turn off diags during 'non forecast'" "flag"
rconfig   integer     num_press_levels    namelist,diags   1              0   -    "number of pressure levels to interpolate diagnostics to"                "index"
rconfig   real            press_levels    namelist,diags   max_plevs      0   -    "array of pressure levels to interpolate diagnostics to"                 "Pa"
rconfig   integer     use_tot_or_hyd_p    namelist,diags   1              2   -    "1=use total pressure, 2=use hydrostatic pressure"                       "flag"
rconfig   integer     extrap_below_grnd   namelist,diags   1              1   -    "1=no extrapolation, 2=extrapolate adiabatically"                        "flag"
rconfig   real        p_lev_missing       namelist,diags   1           -999   -    "missing values below ground, no extrapolation"                          "constant"
rconfig   real        p_lev_intervl8      namelist,diags   max_domains  900   -    "interval to compute/output p level diags if using HTR"                  "s"
rconfig   real        ts_interval_sec     namelist,diags   max_domains 3600   -    "interval to compute/output WRF time series"                             "s"
rconfig   integer     kfeta_shal_only     namelist,diags   max_domains    0   -    "When using KFETA, run for shallow cu only?   0=nope, 1=yep"             "flag"
rconfig   real        kfeta_shal_dlim     namelist,diags   max_domains 4000.0  -     "When using KFETA shallow only, depth limit on shallow clds above LCL"   "meters"
rconfig   integer     grell_shal_only     namelist,diags   max_domains    0   -    "When using any Grell-scheme run for shallow cu only?   0=nope, 1=yep"   "flag"
rconfig   integer     ntied_shal_only     namelist,diags   max_domains    0   -    "When running NTIEDTKE, run for shallow cu only?   0=nope, 1=yep"        "flag"
rconfig   logical     run_kf2             namelist,diags   max_domains .false.  -    "When using KFETA, run with KF2 cld lifetime=modelDT? .true./.false."    "flag"
rconfig   real        shal_fdbfrc2g       namelist,diags   max_domains    1   -    "When running shall_only, precipitation FDBK fraction to grid: 0.0-1.0"  "fraction"

#  Derived, this is interval in seconds that is from auxhist23 interval, computed in check_a_mundo

rconfig   real        p_lev_interval      derived          max_domains  0   -    "interval to compute/output p level diags"                   "s"

#  Arrays that will be filled with interpolated values

state    real   p_pl    {np}    misc    1  Z   h{23}  "P_PL"    "Pressure level data, Pressure"              "Pa"
state    real   u_pl   i{np}j   misc    1  Z   h{23}  "U_PL"    "Pressure level data, U wind"                "m s-1"
state    real   v_pl   i{np}j   misc    1  Z   h{23}  "V_PL"    "Pressure level data, V wind"                "m s-1"
state    real   t_pl   i{np}j   misc    1  Z   h{23}  "T_PL"    "Pressure level data, Temperature"           "K"
state    real   rh_pl  i{np}j   misc    1  Z   h{23}  "RH_PL"   "Pressure level data, Relative humidity"     "%"
state    real   ght_pl i{np}j   misc    1  Z   h{23}  "GHT_PL"  "Pressure level data, Geopotential Height"   "m"
state    real   s_pl   i{np}j   misc    1  Z   h{23}  "S_PL"    "Pressure level data, Speed"                 "m s-1"
state    real   td_pl  i{np}j   misc    1  Z   h{23}  "TD_PL"   "Pressure level data, Dew point temperature" "K"
state    real   q_pl   i{np}j   misc    1  Z   h{23}  "Q_PL"    "Pressure level data, Mixing ratio"          "kg/kg"
#
state    real   wdir_pl   i{np}j   misc    1  Z   h{23}  "WDIR_PL"    "Pressure level data, Wind-dir: clockwise-from-north"  "Degrees"
state    real   thta_pl   i{np}j   misc    1  Z   h{23}  "THTA_PL"    "Pressure level data, Potential Temperature"           "K"
state    real   wwnd_pl   i{np}j   misc    1  Z   h{23}  "WWND_PL"    "Pressure level data, Ave. Vertical W wind"            "CM/S"
state    real   tcon_pl   i{np}j   misc    1  Z   h{23}  "TCON_PL"    "Pressure level data, Total Cld+Hydrometeor Mix Ratio" "kg/kg"
state    real   cconfr_pl i{np}j   misc    1  Z   h{23}  "CCONFR_PL"  "Pressure level data, Cld-Cond Frc of Tot Condensate"  "%"
state    real   rnwtfr_pl i{np}j   misc    1  Z   h{23}  "RNWTFR_PL"  "Pressure level data, Rain-Wat Frc of Tot Condensate"  "%"
state    real   snowfr_pl i{np}j   misc    1  Z   h{23}  "SNOWFR_PL"  "Pressure level data, Snow Frc of Tot Condensate"      "%"
state    real   graufr_pl i{np}j   misc    1  Z   h{23}  "GRAUFR_PL"  "Pressure level data, Graupel Frc of Tot Condensate"   "%"
state    real   avor_pl   i{np}j   misc    1  Z   h{23}  "AVOR_PL"    "Pressure level data, Absolute vorticity"              "1/S"
state    real   pvor_pl   i{np}j   misc    1  Z   h{23}  "PVOR_PL"    "Pressure level data, Pot. vorticty 1E-6*m2s-1*K*kg-1" "PVU"
#
state    real   twet1      ij   misc    1  -   h{8}   "TWET1"       "Layer-1 wet-bulb air temperature"                    "K"
#
state    real   twmean     ij   misc    1  -   h{8}   "TWMEAN"      "Integrated near-surface wet-bulb air temperature"    "K"
state    real   maskfrac   ij   misc    1  -   h{8}   "MASKFRAC"    "Precip frac: freezing <= 0 < mixed < 1 <= liquid"    "none"
state    real   qclay1     ij   misc    1  -   h{8}   "QCLAY1"      "layer-1 cld. liq. wat. mixing ratio at each cell"    "g-liqwat/g-dryair"
state    real   qilay1     ij   misc    1  -   h{8}   "QILAY1"      "layer-1 cloud ice mixing ratio at each cell"         "g-ice/g-dryair"
state    real   qrlay1     ij   misc    1  -   h{8}   "QRLAY1"      "layer-1 rain mixing ratio at each cell"              "g-rain/g-dryair"
state    real   qslay1     ij   misc    1  -   h{8}   "QSLAY1"      "layer-1 snow mixing ratio at each cell"              "g-snow/g-dryair"
state    real   qglay1     ij   misc    1  -   h{8}   "QGLAY1"      "layer-1 graupel mixing ratio at each cell"           "g-grp/g-dryair"
state    real   qnilay1    ij   misc    1  -   h{8}   "QNILAY1"     "layer-1 snow+graupel mixing ratio at each cell"      "g-snow+grp/g-dryair"   
state    real   rain       ij   misc    1  - rh0{8}   "RAIN"        "accumulated total (conv + non-conv) rain"            "mm"
state    real   qv_col     ij   misc    1  -   h{8}   "QVCOLUMN"    "Column-integrated water vapor"                       "mm"
#
state    real   raliqd     ij   misc    1  -   h{8}   "PCPLIQD"     "htr_tstep total (conv + non-conv) liquid rain"       "mm"
state    real   rafzra     ij   misc    1  -   h{8}   "PCPFZRA"     "htr_tstep total (conv + non-conv) freezing rain"     "mm"
state    real   rasnow     ij   misc    1  -   h{8}   "PCPSNOW"     "htr_tstep total (conv + non-conv) snow"              "mm"
state    real   raicep     ij   misc    1  -   h{8}   "PCPICEP"     "htr_tstep total (conv + non-conv) ice pellets"       "mm"   
state    real   raliqdcum  ij   misc    1  - rh0{8}   "PCPLIQD_CUM" "accumulated total (conv + non-conv) liquid rain"     "mm"
state    real   rafzracum  ij   misc    1  - rh0{8}   "PCPFZRA_CUM" "accumulated total (conv + non-conv) freezing rain"   "mm"
state    real   rasnowcum  ij   misc    1  - rh0{8}   "PCPSNOW_CUM" "accumulated total (conv + non-conv) snow"            "mm"
state    real   dysnowcum  ij   misc    1  - rh0{8}   "DYNSNOW_CUM" "dynamic accum total (conv + non-conv) snow depth"    "mm"
state    real   dysnratcu  ij   misc    1  - rh0{8}   "DYSNRAT_CUM" "dynamic accum total (cv+nc) ratio dyn dpth to SWE"   "ratio"
state    real   raicepcum  ij   misc    1  - rh0{8}   "PCPICEP_CUM" "accumulated total (conv + non-conv) ice pellets"     "mm"   
state    real   rain_rate  ij   misc    1  -  h0{8}   "RAIN_RATE"   "rate of total (conv+non-conv) accumltng ppt at sfc"  "mm/s"
state    real   radcv_rate ij   misc    1  -   h{8}   "RAINDC_RATE" "rate of tot deep cnv (CPschem) accumltng ppt at sfc" "mm/s"
#
state    real   prate_inst ij   misc    1  -  h0{8}   "PRATE_INST"  "instantaneous rate of tot conv+non-conv accumltng ppt at sfc"  "mm/s"
state    real   rascv_rate ij   misc    1  -   h{8}   "RAINSC_RATE" "rate of tot shal cnv (CPschem) accumltng ppt at sfc" "mm/s"
state    real   rannc_rate ij   misc    1  -   h{8}   "RAINNC_RATE" "rate of total non-convective accumltng ppt at sfc"   "mm/s"
state    real   sn_nc_rate ij   misc    1  -   h{8}   "SNNC_RATE"   "rate of non-conv accumltng snow/cld-ice at surface"  "mm/s"
state    real   gr_nc_rate ij   misc    1  -   h{8}   "GRNC_RATE"   "rate of non-conv accumltng graupel (sleet/sn-pllts)" "mm/s"
state    real   lq_nc_rate ij   misc    1  -   h{8}   "LQNC_RATE"   "rate of nonconv accumltng liq ppt (true rain) @ sfc" "mm/s"
state    real   sn_cv_rate ij   misc    1  -   h{8}   "SNCV_RATE"   "rate of convctv accumltng snow/cld-ice at surface"   "mm/s"
state    real   gr_cv_rate ij   misc    1  -   h{8}   "GRCV_RATE"   "rate of convctv accumltng graupel (sleet/sn-pllts)"  "mm/s"
state    real   lq_cv_rate ij   misc    1  -   h{8}   "LQCV_RATE"   "rate of convctv accumltng liq ppt (true rain) @ sfc" "mm/s"
state    real   cnvresmask ij   misc    1  -   h{8}   "CVRESMASK"   "resolved scale convective cloud mask (0/1)"          "none"
#
state    real   talay1     ij   misc    1  -   h{8}   "TALAY1"      "layer-1 half-sigma air temperature"                  "K"
state    real   tnsfc      ij   misc    1  -   h{8}   "TNSFC"       "mean near-sfc half-sigma air temperature"            "K"
state    real   ta2        ij   misc    1  -   h{8}   "TA2"         "2 meter air temperature"                             "K"
state    real   apta2      ij   misc    1  -   h{8}   "APTEMP"      "Apparent temp (wind chill or heat index) at 2meters" "F"
state    real   tdew2      ij   misc    1  -   h{8}   "TDEW2"       "2-Meter Dew Point"                                   "K"
state    real   rh2        ij   misc    1  -   h{8}   "RH2"         "2 meter relative humidity"                           "%"
state    real   tw2        ij   misc    1  -   h{8}   "TW2"         "2-Meter wet-bulb air temperature"                    "K"
state    real   twbgt2     ij   misc    1  -   h{8}   "TWBGT2"      "2-Meter wet-bulb globe temperature"                  "K"
state    real   tdsig1     ij   misc    1  -   h{8}   "TDSIG1"      "Layer-1 Dew Point"                                   "K"
state    real   ux10       ij   misc    1  -   h{8}   "UX10"        "10 meter U wind component"                           "M/S"
#
state    real   vx10       ij   misc    1  -   h{8}   "VX10"        "10 meter V wind component"                           "M/S"
state    real   wspd10     ij   misc    1  -   h{8}   "WSPD10"      "Scalar wind speed 10-meters above ground"            "M/S"
state    real   gspd10     ij   misc    1  -   h{8}   "GSPD10"      "Estimated max gust speed 10-meters above ground"     "M/S"
state    real   slprs      ij   misc    1  -   h{8}   "SLPRS"       "WRF Mean-sea-level pressure"                         "mb"
state    real   cfraclo    ij   misc    1  -   h{8}   "CFRACL"      "WRF low-cloud fractional coverage"                   "none"
state    real   cfracmd    ij   misc    1  -   h{8}   "CFRACM"      "WRF medium-cloud fractional coverage"                "none"
state    real   cfrachi    ij   misc    1  -   h{8}   "CFRACH"      "WRF high-cloud fractional coverage"                  "none"
state    real   z1000      ij   misc    1  -   h{8}   "Z1000"       "Elevation above mean sea level at 1000 mb"           "M"
state    real   snolev     ij   misc    1  -   h{8}   "SNOLEV"      "Elevation above mean sea level of snow level"        "M"
state    real   mixlev     ij   misc    1  -   h{8}   "MIXLEV"      "Elevation above mean sea level at mixed level"       "M"
#
state    real   frzlev     ij   misc    1  -   h{8}   "FRZLEV"      "Elevation above mean sea level at freezing level"    "M"
state    real   z850       ij   misc    1  -   h{8}   "Z850"        "Elevation above mean sea level at 850 mb"            "M"
state    real   z700       ij   misc    1  -   h{8}   "Z700"        "Elevation above mean sea level at 700 mb"            "M"
state    real   z500       ij   misc    1  -   h{8}   "Z500"        "Elevation above mean sea level at 500 mb"            "M"
state    real   z300       ij   misc    1  -   h{8}   "Z300"        "Elevation above mean sea level at 300 mb"            "M"
state    real   z250       ij   misc    1  -   h{8}   "Z250"        "Elevation above mean sea level at 250 mb"            "M"
state    real   uwind850   ij   misc    1  -   h{8}   "UWIND850"    "horizontal U wind component at 850 mb"               "M/S"
state    real   vwind850   ij   misc    1  -   h{8}   "VWIND850"    "horizontal V wind component at 850 mb"               "M/S"
state    real   avor850    ij   misc    1  -   h{8}   "AVOR850"     "Absolute vorticity, at 850 mb"                       "1/S"
state    real   rh850      ij   misc    1  -   h{8}   "RH850"       "relative humidity, water-only formula, at 850 m"     "%"
#
state    real   ta850      ij   misc    1  -   h{8}   "TA850"       "Temperature, at 850 mb"                              "K"
state    real   uwind700   ij   misc    1  -   h{8}   "UWIND700"    "horizontal U wind component at 700 mb"               "M/S"
state    real   vwind700   ij   misc    1  -   h{8}   "VWIND700"    "horizontal V wind component at 700 mb"               "M/S"
state    real   wwind700   ij   misc    1  -   h{8}   "WWIND700"    "Average Vertical W wind component at 700 mb"         "CM/S"
state    real   wdir_700   ij   misc    1  -   h{8}   "WDIR700"     "Wind-direction at 700mb clockwise-from-north"        "Degrees" 
state    real   avor700    ij   misc    1  -   h{8}   "AVOR700"     "Absolute vorticity, at 700 mb"                       "1/S"
state    real   rh700      ij   misc    1  -   h{8}   "RH700"       "relative humidity, water-only formula at 700 mb"     "%"
state    real   ta700      ij   misc    1  -   h{8}   "TA700"       "Temperature, at 700 mb"                              "K"
state    real   thtae700   ij   misc    1  -   h{8}   "THTE700"     "Equivalent potential temperature at 700mb"           "K"
state    real   uwind500   ij   misc    1  -   h{8}   "UWIND500"    "horizontal U wind component at 500 mb"               "M/S"
#
state    real   vwind500   ij   misc    1  -   h{8}   "VWIND500"    "horizontal V wind component at 500 mb"               "M/S"
state    real   avor500    ij   misc    1  -   h{8}   "AVOR500"     "Absolute vorticity, at 500 mb"                       "1/S"
state    real   rh500      ij   misc    1  -   h{8}   "RH500"       "relative humidity, water-only formula, at 500 mb"    "%"
state    real   ta500      ij   misc    1  -   h{8}   "TA500"       "Temperature, at 500 mb"                              "K"
state    real   uwind300   ij   misc    1  -   h{8}   "UWIND300"    "horizontal U wind component at 300 mb"               "M/S"
state    real   vwind300   ij   misc    1  -   h{8}   "VWIND300"    "horizontal V wind component at 300 mb"               "M/S"
state    real   rh300      ij   misc    1  -   h{8}   "RH300"       "relative humidity, water-only formula, at 300 mb"    "%"
state    real   ta300      ij   misc    1  -   h{8}   "TA300"       "Temperature, at 300 mb"                              "K"
state    real   wdir_300   ij   misc    1  -   h{8}   "WDIR300"     "Wind-direction at 300mb clockwise-from-north"        "Degrees" 
state    real   wspd300    ij   misc    1  -   h{8}   "WSPD300"     "Scalar wind speed at 300mb"                          "M/S"
#
state    real   uwind250   ij   misc    1  -   h{8}   "UWIND250"    "horizontal U wind component at 250 mb"               "M/S"
state    real   vwind250   ij   misc    1  -   h{8}   "VWIND250"    "horizontal V wind component at 250 mb"               "M/S"
state    real   wspd250    ij   misc    1  -   h{8}   "WSPD250"     "Scalar wind speed at 250mb"                          "M/S"   
state    real   wdir_250   ij   misc    1  -   h{8}   "WDIR250"     "Wind-direction at 250mb clockwise-from-north"        "Degrees" 
state    real   avor250    ij   misc    1  -   h{8}   "AVOR250"     "Absolute vorticity, at 250 mb"                       "1/S"
state    real   rh250      ij   misc    1  -   h{8}   "RH250"       "relative humidity, water-only formula, at 250 mb"    "%"
state    real   ta250      ij   misc    1  -   h{8}   "TA250"       "Temperature, at 250 mb"                              "K"
state    real   dz1000_850 ij   misc    1  -   h{8}   "DZ1000_850"  "Thickness between 1000mb and 850mb surfaces"         "M"
state    real   dz1000_500 ij   misc    1  -   h{8}   "DZ1000_500"  "Thickness between 1000mb and 500mb surfaces"         "M"
state    real   dz850_700  ij   misc    1  -   h{8}   "DZ850_700"   "Thickness between  850mb and 700mb surfaces"         "M"
#
state    real   snodpt     ij   misc    1  -   h{8}   "SNODPT"      "Physical snow depth"                                 "mm"
state    real   rfl_1kmagl ij   misc    1  -   h{8}   "REFL_1KMAGL" "Generic composite radar reflectivity 1km AGL"        "dbZ"
state    real   rfl_maxagl ij   misc    1  -  h0{8}   "REFL_MAXAGL" "Generic Max radar reflectivity from all layers"      "dbZ"
state    real   rfl_mxcagl ij   misc    1  -  h0{8}   "REFL_MXCAGL" "Generic Max radar reflectivity cropping upr layers"  "dbZ"
state    real   rflmpsc1km ij   misc    1  -   h{8}   "RFLMPSC_1KM" "MP-SCHEME calculated radar reflectivity 1km AGL"     "dbZ"
state    real   rflmpscmax ij   misc    1  -   h{8}   "RFLMPSC_MAX" "MP-SCHEME calculated max radar reflectvty all layrs" "dbZ"
state    real   etp_18dbz  ij   misc    1  -  h0{8}   "ETOP_18DBZ"  "Generic Max Height abov MSL of 18dbZ reflectivity"   "Feet"
state    real   etp_mpsc   ij   misc    1  -   h{8}   "ETOP_MPSC"   "MP-SCHEME Max ht. above MSL of 18dbZ reflectivity"   "Feet"
state    real   vilh       ij   misc    1  -   h{8}   "MPSCVIL"     "MP-SCHEME vertically integrted liq water"            "kg m-2"
state    real   radarvilh  ij   misc    1  -   h{8}   "MPSCRADARVIL" "MP-SCHEME vertically integrted liq water from Ze"   "kg m-2"
#
state    real   icflrateprhr ij misc    1  -   h{8}   "IC_FLSHRT_PHR" "In-cloud flash-rate per hour"                      "Flshs/hr"
state    real   cgflrateprhr ij misc    1  -   h{8}   "CG_FLSHRT_PHR" "Cloud-to-ground flash-rate per hour"               "Flshs/hr"
state    real   totflrteprhr ij misc    1  -   h{8}   "TOTFLSHRT_PHR" "Total lightning flash rate per hour"               "Flshs/hr"
state    real   cfractot   ij   misc    1  -   h{8}   "CFRACTOT"    "MAX of WRF high;med;low-cld fractional coverage"     "none"
state    real   mucape     ij   misc    1  -   h{8}   "MUCAPE"      "CAPE wrt parcel w/ max theta-e in lowest 3 km AGL"   "J/KG"
state    real   cinh       ij   misc    1  -   h{8}   "CINH"        "Conv inhib wrt parcel w/ max thetae in lowest 3 km"  "J/KG" 
state    real   mlcape     ij   misc    1  -   h{8}   "MLCAPE"      "CAPE wrt lowest-100mb averaqe parcel"                "J/KG"
state    real   cinm       ij   misc    1  -   h{8}   "CINM"        "Conv inhib wrt lowest-100mb averaqe parcel"          "J/KG" 
state    real   sbcape     ij   misc    1  -   h{8}   "SBCAPE"      "CAPE wrt parcel lifted from lowest model layer"      "J/KG"
state    real   cins       ij   misc    1  -   h{8}   "CINS"        "Conv inhib wrt lowest model layer parcel"            "J/KG" 
#
state    real   srh0_1km   ij   misc    1  -   h{8}   "SRHSFC_1KM"  "Sfc-1 km Storm-Rel Helicity 75%:30R"                 "J/KG"
state    real   srh0_3km   ij   misc    1  -   h{8}   "SRHSFC_3KM"  "Sfc-3 km Storm-Rel Helicity 75%:30R"                 "J/KG"
state    real   ehi_1km    ij   misc    1  -   h{8}   "EHI_1KM"     "Energy-helicity index based on lowest 1KM Helicity"  "None"
state    real   ehi_3km    ij   misc    1  -   h{8}   "EHI_3KM"     "Energy-helicity index based on lowest 3KM Helicity"  "None"
state    real   visib      ij   misc    1  -   h{8}   "VISIBILITY"  "Horiz Vis based on tot h2o burden in lowst mdl lay"  "KM"
state    real   ceiling    ij   misc    1  -   h{8}   "CEILING"     "Cloud ceiling based on vertical light extinction"    "M"
state    real   flghtreg   ij   misc    1  -   h{8}   "FLIGHTREG"   "Flight reg category: VFR:1; MVFR:2; IFR:3; LIFR:4"   "None"
state    real   fogflag    ij   misc    1  -   h{8}   "FOGFLAG"     "Surfce-layer Fog: 0-None;1-Light;2-Moderate;3-Heavy" "None"
state    real   ptyp_fip   ij   misc    1  -  h0{8}   "PTYPE_FIP"   "0:NONE;1:LQRAIN;2:SNOW;3:PELT;4:FZRA;5:DZZL;6:FZDZ"  "None"
state    real   ptyp_cat   ij   misc    1  -   h{8}   "PTYPE_CAT"   "0:NONE;1:RAIN;2:FRZR;3:ICEP;4:SNOW;5:MIXED"          "None"
#
state    real   cat_rain   ij   misc    1  -  h0{8}   "CRAIN"       "0:NO;1:YES for liquid rain"                          "None"
state    real   cat_fzrn   ij   misc    1  -  h0{8}   "CFRZR"       "0:NO;1:YES for freezing rain"                        "None"
state    real   cat_icep   ij   misc    1  -  h0{8}   "CICEP"       "0:NO;1:YES for ice-pellets/sleet"                    "None"
