mucape,cinh,mlcape,cinm,sbcape,cins,srh0_1km,srh0_3km,ehi_1km,ehi_3km,visib,ceiling,flghtreg,fogflag,ptyp_fip,ptyp_cat,cat_rain,cat_fzrn,/
cat_icep,cat_snow,cu_activ,cu_top_m,cu_bot_m,cu_top_ta,uphelmax,wspd10mx,afw_hail,afw_torn,icgpot45,sldpot45,icgpot40,sldpot40,icgpot35,/
sldpot35,icgpot30,sldpot30,icgpot25,sldpot25,icgpot20,sldpot20,icgpot15,sldpot15,icgpot10,sldpot10,sldpot05,icgpot05,sldpot01,icgpot01,/
