## TDEW2: defined above
## RH2: defined above
## QV2: defined above
## WSPD10: defined above
state    real   wdir_10   ij   misc    1  -   h{8}   "WDIR10"     "Wind-direction at 10-meters clockwise-from-north"      "Degrees" 
## Standard Precipitation: defined above
state    real   ratotlcum  ij  misc    1  - rh0{8}   "PCPTOTAL_CUM" "accumulated total (conv + non-conv) PCP (all types)" "mm"
state    real   rafrzn    ij   misc    1  -   h{8}   "PCPFROZEN" "htr_tstep total (conv+non-conv) frozen PCP (all types)" "mm"
state    real   rafrzncum ij   misc    1  -   h{8}   "PCPFRZN_CUM" "accumulated total (conv + non-conv) frozen PCP"       "mm"
state    real   rafrznfr    ij misc    1  -   h{8}   "PCPFRZNFR" "htr_tstep tot fraction of frozen PCP (all types)"       "mm"
state    real   rafrzncumfr ij misc    1  -   h{8}   "PCPFRZNFR_CUM" "accum total fraction of frozen PCP (all types)"     "mm"
state    real   dryairmtot  ij misc    1  -   h{8}   "DRYAIRM_TOT"  "Total Dry Air Mass in Column (base+pert)"            "Pa"
## Some additional vars saved in h8 by modifying Registry.EM_COMMON
state    real   pressfc     ij misc    1  -   h{8}   "PRES2"        "Atmospheric Pressure at 2m"                          "Pa"

## MSLP; SPECHUM2; REFL defined above
## CAWO End
##
state    real   icgpot35   ij   misc    1  -   h{8}   "ICGPOTFL350" "Aircraft Icing Potential at Flight-level 35000ft"    "None"
state    real   sldpot35   ij   misc    1  -   h{8}   "SLDPOTFL350" "Supercooled Large Droplet Potential at FL 35000ft"   "None"
state    real   icgpot30   ij   misc    1  -   h{8}   "ICGPOTFL300" "Aircraft Icing Potential at Flight-level 30000ft"    "None"
state    real   sldpot30   ij   misc    1  -   h{8}   "SLDPOTFL300" "Supercooled Large Droplet Potential at FL 30000ft"   "None"
state    real   icgpot25   ij   misc    1  -   h{8}   "ICGPOTFL250" "Aircraft Icing Potential at Flight-level 25000ft"    "None"
state    real   sldpot25   ij   misc    1  -   h{8}   "SLDPOTFL250" "Supercooled Large Droplet Potential at FL 25000ft"   "None"
state    real   icgpot20   ij   misc    1  -   h{8}   "ICGPOTFL200" "Aircraft Icing Potential at Flight-level 20000ft"    "None"
state    real   sldpot20   ij   misc    1  -   h{8}   "SLDPOTFL200" "Supercooled Large Droplet Potential at FL 20000ft"   "None"
state    real   icgpot15   ij   misc    1  -   h{8}   "ICGPTMSL150" "Aircraft Icing Potential at 15000ft abv MSL"         "None"    
state    real   sldpot15   ij   misc    1  -   h{8}   "SLDPTMSL150" "Supercooled Large Droplet Potential 15000ft abv MSL" "None"    
state    real   icgpot10   ij   misc    1  -   h{8}   "ICGPTMSL100" "Aircraft Icing Potential at 10000ft abv MSL"         "None"
state    real   sldpot10   ij   misc    1  -   h{8}   "SLDPTMSL100" "Supercooled Large Droplet Potential 10000ft abv MSL" "None"    
state    real   icgpot05   ij   misc    1  -   h{8}   "ICGPTMSL050" "Aircraft Icing Potential at 5000ft abv MSL"          "None"       
state    real   sldpot05   ij   misc    1  -   h{8}   "SLDPTMSL050" "Supercooled Large Droplet Potential 5000ft abv MSL"  "None"
state    real   icgpot01   ij   misc    1  -   h{8}   "ICGPTMSL010" "Aircraft Icing Potential at 1000ft abv MSL"          "None"    
state    real   sldpot01   ij   misc    1  -   h{8}   "SLDPTMSL010" "Supercooled Large Droplet Potential 1000ft abv MSL"  "None"
##
state    real   turbdx01   ij   misc    1  -   h{8}   "TURBDX_LAY1" "CAT Turb Index 1500-3000M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"   "None"  
state    real   turbdx02   ij   misc    1  -   h{8}   "TURBDX_LAY2" "CAT Turb Index 3000-4600M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"   "None"  
state    real   turbdx03   ij   misc    1  -   h{8}   "TURBDX_LAY3" "CAT Turb Index 4600-6100M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"   "None"  
state    real   turbdx04   ij   misc    1  -   h{8}   "TURBDX_LAY4" "CAT Turb Index 6100-7600M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"   "None"  
state    real   turbdx05   ij   misc    1  -   h{8}   "TURBDX_LAY5" "CAT Turb Index 7600-9100M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"   "None"  
state    real   turbdx06   ij   misc    1  -   h{8}   "TURBDX_LAY6" "CAT Turb Index 9100-10700M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr"  "None"  
state    real   turbdx07   ij   misc    1  -   h{8}   "TURBDX_LAY7" "CAT Turb Index 10700-12700M AGL: 4-8:Lght-Mod;8-12:Mod;>12 Svr" "None"
state    real   llturb     ij   misc    1  -   h{8}   "LLTURB_DEX"  "Turb Index 0-1500m AGL (4 ingredient); not directly comparable to PIREPS" "None"
state    real   llturblgt  ij   misc    1  -   h{8}   "LLTURBLGT"   "Prob. of light-LLTURB eq_or_exceeding PIREP class for light turb"       "%"
state    real   llturbmdt  ij   misc    1  -   h{8}   "LLTURBMDT"   "Prob. of moderate-LLTURB eq_or_exceeding PIREP class for moderate turb" "%"
state    real   llturbsvr  ij   misc    1  -   h{8}   "LLTURBSVR"   "Prob. of svr-LLTURB eq_or_exceeding PIREP class for svr turb"           "%"
state    real   fits       ij   misc    1  -   h{8}   "FIGTERDEX"   "Fighter Index of Thermal Stress"                     "K"
state    real   llws       ij   misc    1  -   h{8}   "LLWS"        "0-2000 ft wind shear"                                "M/S"
##
state    real   wbfrzlev   ij   misc    1  -   h{8}   "WETBFZAGL"   "Elevation above ground-level where wet-bulb temp=0C"  "M"
state    real   apta2c     ij   misc    1  -   h{8}   "APTEMPC"     "Apparent temp (wind chill or heat index) at 2meters"  "C"
state    real   qv2        ij   misc    1  -   h{8}   "QV2"         "Water Vapor Mixing Ratio at 2meters"                  "kg/kg"
state    real   spechumd   ij   misc    1  -   h{8}   "SPECHUM2"    "Specific Humidity at 2meters"                         "kg/kg"
state    real   soiltlay1  ij   misc    1  -   h{8}   "SOILTLAY1"   "Ave. Soil Temperature in Top Soil Layer"              "C"
state    real   smrellay1  ij   misc    1  -   h{8}   "SMRELLAY1"   "Frac Soil Mois; Top Soil Lay; Abve Plant Wilt Point"  "%"
state    real   smreltot   ij   misc    1  -   h{8}   "SMRELTOTL"   "Frac Soil Mois; All-Soil-Lays; Abv Plant Wilt Point"  "%"
##
state    real   rain_last   ij   misc    1  -  r      "RAIN_LAST" "Last HTR tstep accum total (conv + non-conv) rain"      "mm"
state    real   radcv_last  ij   misc    1  -  r      "RADCV_LAST" "Last HTR tstep accum total convective rain"            "mm" 
state    real   rascv_last  ij   misc    1  -  r      "RASCV_LAST" "Last HTR tstep accum total shallow convective rain"    "mm"
state    real   rannc_last  ij   misc    1  -  r      "RANNC_LAST" "Last HTR tstep accum total non-convective rain"        "mm"
state    real   sn_nc_last  ij   misc    1  -  r      "SN_NC_LAST" "Last HTR tstep accum total non-convective snow"        "mm"
state    real   gr_nc_last  ij   misc    1  -  r      "GR_NC_LAST" "Last HTR tstep accum total non-convective graupel"     "mm"
#
state    real   lq_nc_last  ij   misc    1  -  r      "LQ_NC_LAST" "Last HTR tstep accum total non-convective liq ppt @ sfc "   "mm"
state    real   sn_cv_last  ij   misc    1  -
state    real   gr_cv_last  ij   misc    1  -
state    real   lq_cv_last  ij   misc    1  -
state    real   snowcv      ij   misc    1  -  r      "SN_CV_LAST" "Last HTR tstep accum cvctv tot snow/cld-ice at surface"  "mm"
state    real   graupelcv   ij   misc    1  -  r      "GR_CV_LAST" "Last HTR tstep accum cvctv tot graupel (sleet/sn-pllts)" "mm"
state    real   liquidcv    ij   misc    1  -  r      "LQ_CV_LAST" "Last HTR tstep accum cvctv tot liq ppt @ sfc "           "mm"
state integer   cu_act_last ij   misc    1  -  r      "CU_ACT_LAST" "Was a CP scheme cloud active w/in last outpt tstep"   "None"
state    real   cu_top_last ij   misc    1  -  r      "CU_TOP_LAST" "Last HTR tstep Top of param cumulus cloud, if any"   "M"
state    real   cu_bot_last ij   misc    1  -  r      "CU_BOT_LAST" "Last HTR tstep Bottom of param cu cloud, if any "    "M"
#
state integer   cu_ishall   ij   misc    1  -  r      "CU_SHALL"   "Cu:none(-1),shall(1),deep(0) w/in this HTR stp"       "None"
state integer   cu_ish_last ij   misc    1  -  r      "CUISH_LAST" "Cu:none(-1),shall(1),deep(0) w/in LAST HTR stp"       "None"
state    real   cu_ctt_last ij   misc    1  -  r      "CU_CTT_LAST" "Cu cloud top temperature w/in LAST HTR stp, if any"  "K" 
state    real   cu_ktop_lst ij   misc    1  -  r      "CU_KTOP_LAST"  "Cu top K when CP actv w/in LAST HTR tstep:restart" "None"
state    real   cu_kbot_lst ij   misc    1  -  r      "CU_KBOT_LAST"  "Cu bot K when CP actv w/in LAST HTR tstep:restart" "None"
state    real   cu_ktop     ij   misc    1  -  r      "CU_KTOP"  "Cu top K when CP actv w/in this HTR tstep:restart"      "None"
state    real   cu_kbot     ij   misc    1  -  r      "CU_KBOT"  "Cu bot K when CP actv w/in this HTR tstep:restart"      "None"
state    real   cutop_acc   ij   misc    1  -  r      "CUTOP_ACC" "Accumultor for cvctv cld tops btwn HTR outstps, K-lev" "None"
state    real   cubot_acc   ij   misc    1  -  r      "CUBOT_ACC" "Accumultor for cvctv cld bots btwn HTR outstps, K-lev" "None"
state    real   rainc_acc   ij   misc    1  -  r      "RAINC_ACC" "Accumultor for cvctv pcp btwn HTR outstps,for restart" "MM"  
#
state integer   nclds_acc   ij   misc    1  -  r      "NCLDS_ACC" "Accumultor for nmbr of cv clds btwn HTR outstps"       "None"
state    real   chmin_acc   ij   misc    1  -      
state    real   cu_chmin    ij   misc    1  -
state    real   kf_chm_last ij   misc    1  -  r      "KF_CHM_LAST"  "Min depth of KF cloud bridging this HTR tstp:rstrt"  "Meters"
state    real   kf_top_last ij   misc    1  -  r      "KF_TOP_LAST"  "Cu top K when KF cld bridging this HTR tstep:rstrt"  "None"
state    real   kf_bot_last ij   misc    1  -  r      "KF_BOT_LAST"  "Cu bot K when KF cld bridging this HTR tstep:rstrt"  "None"
state logical   cu_exp_flag ij   misc    1  -  r      "CU_EXP_FLAG"  "False: a cloud will bridge the HTR outstep: rstrt"   "None"
state    real   nxtsecs_htr -    misc    1  -   
state logical   jstcald_htr -    misc    1  -
state    real   kf_initsecs ij   misc    1  -  r      "KFINITSECS"  "Init time for KF cloud when bridging this HTR stp:restart" "None"
#
state    real   kf_exprsecs ij   misc    1  -  r      "KFEXPRSECS"  "Expire tim for KF cloud when bridging this HTR stp:restart" "None"
state    real   refl_htrgen ikj  misc    1  -
state    real   relvort     ikj  misc    1  -

#  Package declarations

package   skip_press_diags      p_lev_diags==0     -        -
package        press_diags      p_lev_diags==1     -        state:p_pl,u_pl,v_pl,t_pl,rh_pl,ght_pl,s_pl,td_pl,q_pl,twet1,twmean,maskfrac,/
qclay1,qilay1,qrlay1,qslay1,qglay1,qnilay1,rain,qv_col,raliqd,rafzra,rasnow,raicep,raliqdcum,rafzracum,rasnowcum,dysnowcum,dysnratcu,raicepcum,/
rain_rate,radcv_rate,prate_inst,rascv_rate,rannc_rate,sn_nc_rate,gr_nc_rate,lq_nc_rate,sn_cv_rate,gr_cv_rate,lq_cv_rate,cnvresmask,talay1,tnsfc,/
ta2,apta2,tdew2,rh2,tw2,twbgt2,tdsig1,ux10,vx10,wspd10,gspd10,slprs,cfraclo,cfracmd,cfrachi,z1000,snolev,mixlev,frzlev,z850,z700,z500,z300,z250,/
