# =============================================================================
# inacawo-src — keep COAWST source + headers; exclude build/runtime artifacts
# =============================================================================

# Active header is regenerated by build_coawstM.bash from canonical variants
inacawo-coawst/Projects/CAWO_3way/cawo_3way.h

# Deployed binaries (IHT MODEL_BASE install dirs)
cawo_3way_swell_mods_ramp_tides/
cawo_3way_swell_mods_no_ramp_tides/
**/coawstM
**/coawstM.*

# Build products
**/Build/
**/*.o
**/*.mod
**/*.a
**/*.ipo
**/*.exe
**/make_macros.mk
compile*.out
tree.*.out
tree.my_installation.out

# Project runtime data (not needed to compile; restore on HPC if required)
**/Projects/**/input/
**/Projects/**/output/

# Build / compile logs
logs/
*.log
logs_build_nohup.out

# Editor / OS noise
*~
*.swp
.DS_Store
